{
  "name": "@saerosoft/note-gui",
  "version": "0.9.3",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saerosoft/note-gui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "module": "./dist/note-gui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": { "types": "./dist/types/index.d.ts", "import": "./dist/note-gui.js" },
    "./style.css": { "types": "./dist/types/style.css.d.ts", "default": "./dist/note-gui.css" },
    "./kms": { "types": "./dist/types/kms.d.ts", "import": "./dist/kms.js" }
  },
  "files": ["dist", "LICENSE", "NOTICE", "CONTRACT.md", "OPERATIONS.md", "release.json"],
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 9090",
    "build": "node scripts/source-offer.mjs && tsc --noEmit && tsc --project tsconfig.library.json && vite build --config vite.library.config.ts && node scripts/library-types.mjs && node scripts/verify-distribution.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:independent": "node scripts/build-drawio-fixture.mjs && playwright test --config playwright.independent.config.ts",
    "test:native-drawio": "node scripts/build-native-drawio-fixture.mjs && playwright test --config playwright.native-drawio.config.ts",
    "example": "node scripts/independent-host.mjs",
    "test:package": "node scripts/test-package-consumer.mjs",
    "source": "node scripts/source-offer.mjs",
    "source-offer": "node scripts/source-offer.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.35.0",
    "@tiptap/pm": "3.35.0"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-flourish": "3.2.5",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-live-region": "2.1.0",
    "@braintree/sanitize-url": "7.1.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@floating-ui/dom": "1.8.0",
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "@mantine/core": "9.8.2",
    "@mantine/hooks": "9.8.2",
    "@playwright/test": "1.65.1",
    "@tabler/icons-react": "3.52.0",
    "@tanstack/react-virtual": "3.14.26",
    "@testing-library/react": "16.3.3",
    "@tiptap/extension-bubble-menu": "3.35.0",
    "@tiptap/extension-code-block": "3.35.0",
    "@tiptap/extension-code-block-lowlight": "3.35.0",
    "@tiptap/extension-document": "3.35.0",
    "@tiptap/extension-floating-menu": "3.35.0",
    "@tiptap/extension-heading": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-link": "3.35.0",
    "@tiptap/extension-list": "3.35.0",
    "@tiptap/extension-placeholder": "3.35.0",
    "@tiptap/extension-table": "3.35.0",
    "@tiptap/extension-text": "3.35.0",
    "@tiptap/extensions": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@tiptap/suggestion": "3.35.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "dompurify": "3.4.18",
    "i18next": "27.2.3",
    "jotai": "3.0.2",
    "jsdom": "31.0.1",
    "lowlight": "3.3.0",
    "mermaid": "12.3.0",
    "postcss": "8.5.33",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-i18next": "18.0.3",
    "rfc6902": "5.5.0",
    "typescript": "7.0.2",
    "uuid": "14.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
